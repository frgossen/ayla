.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyrefly/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Jupyter
.ipynb_checkpoints/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

